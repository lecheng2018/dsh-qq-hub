#!/bin/sh
# pre-push：本地兜底门禁，push 之前就红。
#
# 两道检查，串行执行，任一不过就拦下（exit 1）：
#
#   ① PII / 密钥门禁 —— 扫描本次要离开本机的内容（待推送提交 + 工作区改动）。
#      来自 pii-guard 技能；扫描器启动前会先跑自检，因为一个坏掉的扫描器
#      仍然会打印「未发现敏感信息 ✓」，只看结果看不出这种事。
#
#   ①b 裸号码（QQ 号 / 群号）—— 关键词规则抓不到的写法：`group:<群号>`、
#      `真机：<群号>`、测试 fixture。按形状判，见 scripts/check-numbers.mjs。
#
#   ② 面板产物同源 —— client/client.js 是 esbuild 产物、和 client/src 一起入库。
#      改了 src（或改了 scripts/build-client.mjs 的 postProcess）却忘记重新提交
#      产物时，`npm test` 会现场构建、测试照样全绿，只有 CI 会红 ——
#      2026-11-19 的 f1e6100 / bd7f993 就是这样红的。
#      检查逻辑与 CI 完全同源：scripts/build-client.mjs --check（只比对、不落盘）。
#
# 顺序说明：PII 先跑。它更便宜，而且一旦要拦，没必要先花几十秒去构建比对。
#
# 紧急情况下可 `git push --no-verify` 跳过，但 CI 仍会拦产物同源问题。
# 启用方式：npm run setup:hooks（`npm ci` 也会自动执行一次）。
#
# ── 历史 ──────────────────────────────────────────────────────────────────
# 本文件原来只有 ②。2026-11-21 把 ① 合进来时保留了 ② 的原文与注释 ——
# 直接覆盖会删掉产物同源这道防线，那修的是真实发生过的事故，不能丢。

# 钩子本身不需要 stdout 交互，但 **stdin 必须只读一次**：
# push 传进来的 ref 行是一条流，第一个 `while read` 循环会把它读干，
# 于是后面那几道门禁的分支循环执行 0 次 —— 门禁看着在跑，实际什么都没扫。
set -eu

root=$(git rev-parse --show-toplevel)
cd "$root"

REFS_TMP=$(mktemp "${TMPDIR:-/tmp}/qqhub-prepush-refs.XXXXXX")
SELFTEST_TMP=$(mktemp "${TMPDIR:-/tmp}/qqhub-prepush-selftest.XXXXXX")
trap 'rm -f "$REFS_TMP" "$SELFTEST_TMP"' EXIT INT TERM
cat > "$REFS_TMP"
if [ ! -s "$REFS_TMP" ]; then
  echo "pre-push: 没收到 ref 行（stdin 为空），无法确定待推送范围，已拦下。" >&2
  exit 1
fi

# ---------------------------------------------------------------------------
# ① PII / 密钥门禁
# ---------------------------------------------------------------------------
# 扫描器优先级：① PII_SCAN 指定/默认的外部 pii-guard 扫描器（NAS 上那份）；
# ② 找不到时回落到仓库自带的 scripts/pii-scan.mjs（零依赖，Node 即可，与 CI 同一份规则）。
# 2026-11-23 之前找不到就直接「跳过」—— 结果这道门禁在开发机上从来没跑过，
# 十几个真实群号/QQ 号就这样进了公开历史。
# 审计 T2.9：默认只用**仓内**扫描器。旧默认值写死了开发机上的私有绝对路径，
# 换台机器就静默走「找不到 → 跳过」，这道门禁等于不存在。
PII_SCAN="${PII_SCAN:-}"
PII_SELFTEST="${PII_SELFTEST:-}"
[ -n "$PII_SELFTEST" ] || [ -z "$PII_SCAN" ] || PII_SELFTEST="$(dirname "$PII_SCAN")/selftest.py"
PII_PYTHON="${PII_PYTHON:-python3}"
PII_NODE="${PII_NODE:-node}"

pii_kind=""
if [ -n "$PII_SCAN" ] && [ -f "$PII_SCAN" ]; then
  pii_kind=python
elif [ -f "$root/scripts/pii-scan.mjs" ] && command -v "$PII_NODE" >/dev/null 2>&1; then
  pii_kind=node
fi

pii_selftest() {
  if [ "$pii_kind" = python ]; then
    [ -f "$PII_SELFTEST" ] || return 0
    "$PII_PYTHON" -I "$PII_SELFTEST"
  else
    "$PII_NODE" "$root/scripts/pii-scan.mjs" selftest
  fi
}

pii_run() {
  if [ "$pii_kind" = python ]; then
    "$PII_PYTHON" -I "$PII_SCAN" git "$@"
  else
    "$PII_NODE" "$root/scripts/pii-scan.mjs" git "$@"
  fi
}

if [ -n "$pii_kind" ]; then
  # 自检前置：扫描器本身坏了的时候，它会给出「干净」的假结论。
  if [ "${PII_SKIP_SELFTEST:-0}" != "1" ]; then
    if ! pii_selftest >"$SELFTEST_TMP" 2>&1; then
      echo "" >&2
      echo "pre-push: PII 扫描器自检未通过，已拦下这次 push。" >&2
      echo "  一个坏掉的扫描器会给出「干净」的假结论，所以这里宁可拦下。" >&2
      sed 's/^/  /' "$SELFTEST_TMP" >&2
      exit 1
    fi
  fi
  echo "pre-push: PII 扫描本次要推送的内容……" >&2
  # 一次性读入 stdin（push 传进来的 ref 行），再喂给扫描逻辑；
  # 不加 --no-worktree：工作区里已跟踪的改动也会被这次 push 带走。
  if ! git rev-parse --git-dir >/dev/null 2>&1; then
    echo "pre-push: 当前目录不是 git 仓库，无法确定待推送范围，已拦下。" >&2
    exit 1
  fi
  pii_fail=0
  while read -r local_ref local_sha remote_ref remote_sha; do
    case "$local_sha" in
      0000000000*) continue ;;          # 删除远端分支，无内容可扫
    esac
    if printf '%s' "$remote_sha" | grep -q '^0*$'; then
      base=$(git rev-parse --verify -q origin/main 2>/dev/null \
          || git rev-parse --verify -q origin/master 2>/dev/null \
          || git rev-parse --verify -q main 2>/dev/null \
          || git rev-parse --verify -q master 2>/dev/null)
      if [ -n "$base" ]; then
        mb=$(git merge-base "$base" "$local_sha" 2>/dev/null || echo "$base")
        pii_run --range "$mb..$local_sha" || pii_fail=1
      else
        pii_run --tree || pii_fail=1
      fi
    else
      pii_run --range "$remote_sha..$local_sha" || pii_fail=1
    fi
  done < "$REFS_TMP"
  if [ "$pii_fail" -ne 0 ]; then
    echo "" >&2
    echo "pre-push: 检测到疑似私人信息/密钥，已拦下这次 push。" >&2
    echo "  请先脱敏；确认为假数据的测试行可用行内标记 pii-scan:ignore" >&2
    echo "  （仅豁免 LOW/MEDIUM，HIGH 始终要人工处理）。" >&2
    exit 1
  fi
else
  echo "pre-push: 未找到 PII 扫描器（PII_SCAN 未设置或不存在，scripts/pii-scan.mjs 也不可用），跳过这一道。" >&2
fi

# ---------------------------------------------------------------------------
# ①b 裸号码门禁 —— QQ 号 / 群号
# ---------------------------------------------------------------------------
# 2026-11-23 事故：pii-guard 的 qq-number 规则要求「QQ：」「群号：」这类上下文关键词，
# 于是 `"chatId": "group:<群号>"`、`真机：<群号>` 这种写法一律被放过，
# 真实群号直接进了 public 仓库。
# 这一道不看关键词，只看形状（8–12 位、排除 YYYYMMDD 日期与标识符），
# 确属假数据的行用行内 `pii-scan:ignore` 显式豁免。
if [ "${PII_SKIP_NUMBERS:-0}" != "1" ]; then
  echo "pre-push: 检查新增行里的 QQ 号 / 群号形状数字……" >&2
  num_fail=0
  while read -r local_ref local_sha remote_ref remote_sha; do
    case "$local_sha" in
      0000000000*) continue ;;
    esac
    if printf '%s' "$remote_sha" | grep -q '^0*$'; then
      base=$(git rev-parse --verify -q origin/main 2>/dev/null || git rev-parse --verify -q main 2>/dev/null)
      if [ -n "$base" ]; then
        mb=$(git merge-base "$base" "$local_sha" 2>/dev/null || echo "$base")
        nrange="${mb}..${local_sha}"
      else
        nrange="HEAD~1..HEAD"
      fi
    else
      nrange="${remote_sha}..${local_sha}"
    fi
    if ! "$PII_NODE" scripts/check-numbers.mjs --range "$nrange"; then num_fail=1; fi
  done < "$REFS_TMP"
  if [ "$num_fail" -ne 0 ]; then
    echo "" >&2
    echo "pre-push: 新增内容里有 QQ 号 / 群号形状的数字，已拦下。" >&2
    echo "  排障记录里请用「某个群」「<群号>」这类占位；" >&2
    echo "  确属假数据的测试 fixture 可加行内标记 pii-scan:ignore 显式豁免。" >&2
    echo "  （确需跳过：PII_SKIP_NUMBERS=1 git push …）" >&2
    exit 1
  fi
fi

# ---------------------------------------------------------------------------
# ② 面板产物同源（原有检查，保持不变）
# ---------------------------------------------------------------------------
if [ ! -d node_modules ]; then
  echo "pre-push: 缺少 node_modules，跳过面板产物同源检查（先 npm ci）" >&2
  exit 0
fi

echo "pre-push: 检查 client/client.js 是否与 client/src 同步……"
if ! npm run --silent check:client; then
  echo "" >&2
  echo "pre-push: 面板产物与源码不同步，已拦下这次 push。" >&2
  echo "          运行 npm run build:client 并把 client/client.js 一起提交后重试。" >&2
  echo "          （确需跳过：git push --no-verify，但 CI 的 Verify 仍会红）" >&2
  exit 1
fi