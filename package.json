{
  "name": "dsh-qq-hub",
  "version": "1.5.3",
  "description": "把 QQ 接入 DeepSeek Harness：经 SnowLuma / OneBot v11 接私聊与群聊，支持按会话隔离的记忆、多平台链接解析与网页管理面板。",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "src/host.js",
  "exports": {
    ".": "./src/host.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "install:browser": "node scripts/install-browser.mjs",
    "prepack": "node scripts/build-client.mjs",
    "test": "node scripts/build-client.mjs && node --import ./test/helpers/isolate-env.mjs --test \"test/**/*.test.js\"",
    "test:extensions": "npm run --prefix extensions/tieba-reader test",
    "test:all": "npm test && npm run test:extensions",
    "lint": "eslint src scripts/*.mjs",
    "benchmark": "node scripts/benchmark-replay.mjs",
    "smoke:pack": "node scripts/smoke-pack.mjs",
    "pack:check": "npm pack --dry-run",
    "check:client": "node scripts/build-client.mjs --check",
    "check:numbers": "node scripts/check-numbers.mjs",
    "setup:hooks": "node scripts/setup-hooks.mjs",
    "pii:scan": "node scripts/pii-scan.mjs --tree",
    "pii:selftest": "node scripts/pii-scan.mjs selftest"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ],
      "external": [
        "react"
      ]
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "dsh-hub",
    "dsh-agent",
    "qq-hub",
    "qq-agent",
    "qq",
    "onebot"
  ],
  "files": [
    "extensions",
    "src",
    "scripts",
    "client",
    "personas",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "docs/DEVELOPMENT.md",
    "docs/USER-MANUAL.md",
    "docs/CONFIGURATION.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/lecheng2018/dsh-qq-hub.git"
  },
  "homepage": "https://github.com/lecheng2018/dsh-qq-hub",
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "globals": "^16.5.0"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  },
  "dependencies": {
    "undici": "^7.29.1"
  }
}
